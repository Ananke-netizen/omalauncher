widget "answer" {
  page: 1
  order: 10
  size: 3x2
  minSize: 2x2
  meta { description: "The newest Pantheon inbox note from the home server, over Tailscale. The ssh runs curl on the server itself, so the token never leaves it. Needs Linux and Tailscale. Tap to open Pantheon."; version: "1.0"; license: "MIT"; category: "house"; owl: 5 }

  // One ssh, one curl, on the Pi: the bridge listens on its tailnet IP there, and the token
  // is read on the server and never crosses to the phone. The inner '...' stops the guest's
  // own shell from expanding $(cat ...) here; the Pi's shell expands it there.
  source last = cmd("ssh -o BatchMode=yes -o ConnectTimeout=6 raspberrypi 'curl -s -m 8 -H \"X-Pocket-Token: $(cat ~/.hermes-pocket/token)\" http://100.79.208.106:8097/api/inbox/last'") every 5m json status timeout 25s optional
  let body = last.ok ? trim(last.out.text ?? "") : ""
  onTap: androidApp("com.axum.pocket")

  Column {
    gap: 4
    fill: true
    Text { text: last.ok ? "hermes" : "answer offline"; style: label; color: muted }
    Text { text: body == "" ? (last.ok ? "nothing yet" : "needs Linux + Tailscale") : sub(body, 0, 120); maxLines: 5; weight: 1 }
  }
}
